# Segredos locais de dev. Copie para .env (gitignored).
#
# O prefixo NUXT_ é OBRIGATÓRIO para tudo que é lido via useRuntimeConfig():
# o Nitro procura `NUXT_` + SNAKE_CASE da chave, então uma var chamada só
# AUTH_SECRET é ignorada em silêncio. Antes o app caía num default do
# nuxt.config.ts; hoje esses defaults estão vazios de propósito (segredo em
# default vai para o bundle do worker), então a var faltando QUEBRA.
#
# Exceções lidas de process.env direto: DATABASE_URL, S3_*, SYNC_TOKEN_SECRET
# e as de script/teste no fim do arquivo.
#
# Produção não usa este arquivo — ver DEPLOY.md (`wrangler secret put`).

# ── Obrigatórias ────────────────────────────────────────────────────────────
# openssl rand -base64 32
NUXT_AUTH_SECRET=change_me_to_a_long_random_string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/comando_dev

# ── Email (Resend) ──────────────────────────────────────────────────────────
# VAZIO EM DEV, de propósito: sem a chave o mailer cai no stub e IMPRIME o email
# no console do servidor. É de lá que saem o código OTP do login e os links de
# confirmar/desmarcar agendamento.
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM_EMAIL=comando@localhost
# ⚠️ Var INERTE: está declarada no nuxt.config.ts e no wrangler.jsonc, mas
# nenhum código a lê. Não promove ninguém a owner — isso é manual (ver DEPLOY.md §4).
NUXT_ADMIN_BOOTSTRAP_EMAIL=

# ── URLs ────────────────────────────────────────────────────────────────────
# Vazio em dev = os call sites caem em http://localhost:3000.
# É o expectedOrigin do WebAuthn e a base dos links de convite/agendamento.
NUXT_PUBLIC_SITE_URL=

# ── Tempo real (worker comando-sync) ────────────────────────────────────────
# Sem os dois o app funciona, só que em polling em vez de WebSocket.
# O segredo precisa ser o MESMO nos dois workers — ver workers/sync/README.md.
SYNC_TOKEN_SECRET=
# Ex.: wss://comando-sync.<subdominio>.workers.dev/ws
NUXT_PUBLIC_SYNC_URL=

# ── IA (Claude, MCP, classificador, página /comando) ────────────────────────
# Três provedores atrás da mesma interface (server/utils/llm/). Configure UM.
# Tudo vazio = as features de IA respondem erro explicando o que falta; o resto
# do app funciona igual.
#
# Vazio = usa o primeiro provedor que tiver chave (anthropic → openai → google).
NUXT_LLM_PROVIDER=
# Vazio = o padrão do provedor escolhido:
#   anthropic claude-sonnet-5 · openai gpt-4o · google gemini-2.0-flash
# Confirme o id atual no painel do provedor antes de fixar um valor aqui.
NUXT_LLM_MODEL=
NUXT_ANTHROPIC_API_KEY=
NUXT_OPENAI_API_KEY=
NUXT_GOOGLE_AI_API_KEY=
# Só para apontar o adaptador OpenAI a um endpoint compatível (Groq, Together,
# OpenRouter, Ollama). Vazio = https://api.openai.com/v1
NUXT_OPENAI_BASE_URL=

# ── Anexos — storage compatível com S3 ──────────────────────────────────────
# Em branco desliga os endpoints de anexo sem quebrar o resto do app.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Modo demonstração (webinar) — NUNCA ligar em produção ───────────────────
# NUXT_DEMO_BYPASS=1 habilita /api/auth/demo-login, que loga SEM AUTENTICAÇÃO.
NUXT_DEMO_BYPASS=
NUXT_DEMO_EMAIL=demo@comando.app
NUXT_PUBLIC_DEMO_MODE=

# ── Scripts e testes (não vão para o runtime do worker) ─────────────────────
# ⚠️ Os testes de integração dão TRUNCATE no banco inteiro. O helper recusa
# rodar se o nome não terminar em "_test" (ALLOW_TEST_DB_WIPE=1 força).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/comando_test
# pnpm db:seed:user
SEED_EMAIL=
SEED_NAME=
SEED_ROLE=
# pnpm db:seed:demo
DEMO_EMAIL=
DEMO_NAME=
# pnpm ia — dono padrão, para não repetir --owner em todo comando
IA_OWNER=
